@page
@model NEWPOP.Pages.ChangePasswordModel
@{ Layout = null; }

<div class="container mt-5" style="max-width: 400px;">
    <h3>비밀번호 변경</h3>
    <form method="post">
        <input type="text" asp-for="UpdateData.UserId" class="form-control mb-2" placeholder="아이디" required />
        <input type="password" asp-for="UpdateData.OldPassword" class="form-control mb-2" placeholder="기존 비밀번호" required />
        <input type="password" asp-for="UpdateData.NewPassword" class="form-control mb-2" placeholder="새 비밀번호" required />
        <button type="submit" class="btn btn-warning w-100">변경하기</button>
        <a asp-page="/Login" class="btn btn-link w-100">로그인으로 돌아가기</a>
    </form>
</div>