@page
@model LoginModel
@{
    Layout = null; // 메뉴가 없는 빈 페이지로 설정
}

<!DOCTYPE html>
<html>
<head>
    <title>로그인</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .login-card {
            width: 400px;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            background: white;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h3 class="text-center mb-4">시스템 로그인</h3>
        <form method="post">
            <div class="mb-3">
                <label>아이디</label>
                <input type="text" asp-for="Input.UserId" class="form-control" placeholder="ID를 입력하세요" required />
            </div>
            <div class="mb-3">
                <label>비밀번호</label>
                <input type="password" asp-for="Input.Password" class="form-control" placeholder="Password를 입력하세요" required />
            </div>
            <button type="submit" asp-page-handler="Login" class="btn btn-primary w-100 mb-2">로그인</button>

            <a asp-page="/ChangePassword" class="btn btn-outline-secondary w-100">비밀번호 변경</a>
        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger mt-2">정보가 일치하지 않습니다.</div>
        }
    </div>
</body>
</html>